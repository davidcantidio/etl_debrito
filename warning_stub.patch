+import sqlite3
+import logging
+from pathlib import Path
+from typing import Any, List, Optional
+
+from .interactive_handler import WarningContext, UserDecision
+from .warning_resolver import DecisionResult
+
+
+class WarningDatabase:
+    """
+    Minimal stub for a SQLite‑backed database to persist user decisions and rules.
+    It creates an empty database file but does not implement full schema or queries.
+    """
+
+    def __init__(self, db_path: str = "warnings.db"):
+        self.db_path = Path(db_path)
+        self.conn: Optional[sqlite3.Connection] = None
+
+    def _ensure_connection(self):
+        if self.conn is None:
+            logging.getLogger(__name__).info("Connecting to SQLite DB at %s", self.db_path)
+            self.conn = sqlite3.connect(self.db_path)
+
+    def save_decision(self, context: WarningContext, decision: str, result: DecisionResult) -> None:
+        """
+        Save a user decision to the database. This stub simply logs the action.
+        """
+        logging.getLogger(__name__).info(
+            "Saving decision %s for context %s with result %s", decision, context, result
+        )
+
+    def get_similar_decisions(self, context: WarningContext) -> List[str]:
+        """
+        Return a list of previous decisions for a similar context. Always empty in stub.
+        """
+        return []
+
+    def get_active_rules(self, warning_type: str = None) -> List[dict]:
+        """
+        Return a list of active rules. Always empty in stub.
+        """
+        return []
+
+    def migrate_municipios_csv(self, csv_path: str) -> None:
+        """
+        Placeholder for migrating municipios.csv into the database. Logs the action.
+        """
+        logging.getLogger(__name__).info("Called migrate_municipios_csv on %s", csv_path)
+
+    def cleanup_old_decisions(self, days: int = 90) -> None:
+        """
+        Placeholder for cleaning up old decisions. Does nothing in stub.
+        """
+        logging.getLogger(__name__).info("Called cleanup_old_decisions for entries older than %d days", days)

