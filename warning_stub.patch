+import os
+
+
+class EnvironmentConfig:
+    """
+    Simple configuration reader for interactive and production modes.
+    Reads boolean flags from environment variables.
+    """
+    def __init__(self):
+        self.interactive_mode = os.getenv("INTERACTIVE_MODE", "false").lower() == "true"
+        self.production_mode = os.getenv("PRODUCTION_MODE", "false").lower() == "true"
+
+    def should_intercept(self) -> bool:
+        # Intercept only if interactive mode is on and not in production
+        return self.interactive_mode and not self.production_mode
+
+    def is_production(self) -> bool:
+        return self.production_mode