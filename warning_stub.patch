+class PerformanceGuard:
+    """
+    Simple performance guard that tracks API calls and raises an exception
+    if the number of calls exceeds a configured maximum.
+    """
+    def __init__(self, max_calls: int = 2):
+        self.api_calls = 0
+        self.max_calls = max_calls
+
+    def before_api_call(self, operation: str) -> None:
+        self.api_calls += 1
+        if self.api_calls > self.max_calls:
+            raise RuntimeError(
+                f"Exceeded {self.max_calls} API calls limit while performing {operation}"
+            )
+
+    def reset(self) -> None:
+        self.api_calls = 0

