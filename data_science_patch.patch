"""
Funções auxiliares para validações de qualidade de dados adicionais.

Estas funções fornecem validações comuns como verificação de intervalos numéricos
e detecção de linhas duplicadas, complementando os métodos existentes em
`validations.py`. Elas registram warnings mas não interrompem a execução.
"""
from __future__ import annotations

from typing import Dict, Optional, List, Tuple, Any
import pandas as pd
import logging

logger = logging.getLogger(__name__)


def validate_numeric_ranges(df: pd.DataFrame, numeric_ranges: Dict[str, Tuple[Optional[float], Optional[float]]]) -> None:
    """
    Verifica se valores em colunas numéricas estão dentro de intervalos esperados e registra warnings.

    Args:
        df: DataFrame contendo os dados a validar.
        numeric_ranges: Dicionário no formato {coluna: (min, max)}.

    Exemplo:
        validate_numeric_ranges(df, {"valor_gasto": (0, 1e7), "impressions": (0, None)})
    """
    for col, (min_value, max_value) in numeric_ranges.items():
        if col not in df.columns:
            continue
        # Tenta converter a coluna para numérico; valores não numéricos se tornam NaN
        serie = pd.to_numeric(df[col], errors="coerce")
        if min_value is not None:
            below_min = serie < min_value
            if below_min.any():
                linhas = below_min[below_min].index.tolist()
                preview = ", ".join(str(i) for i in linhas[:10]) + ("…" if len(linhas) > 10 else "")
                logger.warning(
                    f"[Validação] Coluna '{col}' possui {below_min.sum()} valor(es) abaixo de {min_value}: {preview}"
                )
        if max_value is not None:
            above_max = serie > max_value
            if above_max.any():
                linhas = above_max[above_max].index.tolist()
                preview = ", ".join(str(i) for i in linhas[:10]) + ("…" if len(linhas) > 10 else "")
                logger.warning(
                    f"[Validação] Coluna '{col}' possui {above_max.sum()} valor(es) acima de {max_value}: {preview}"
                )


def validate_duplicate_rows(df: pd.DataFrame, subset: Optional[List[str]] = None) -> None:
    """
    Verifica a existência de linhas duplicadas e registra um aviso.

    Args:
        df: DataFrame a ser verificado.
        subset: Lista de colunas que definem unicidade; se None, verifica duplicados considerando todas as colunas.
    """
    duplicated = df.duplicated(subset=subset, keep=False)
    if duplicated.any():
        linhas = duplicated[duplicated].index.tolist()
        preview = ", ".join(str(i) for i in linhas[:10]) + ("…" if len(linhas) > 10 else "")
        cols_desc = ', '.join(subset) if subset else 'todas'
        logger.warning(
            f"[Validação] Existem {duplicated.sum()} linha(s) duplicada(s) nas colunas {cols_desc}: {preview}"
        )

