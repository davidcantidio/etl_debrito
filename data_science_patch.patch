import pandas as pd
import logging
from transform.transform.utils import data_quality


def test_validate_numeric_ranges_no_warning(caplog):
    df = pd.DataFrame({"valor": [10, 20, 30]})
    with caplog.at_level(logging.WARNING):
        data_quality.validate_numeric_ranges(df, {"valor": (0, 100)})
    # Should not log warnings
    assert not any(record.levelname == "WARNING" for record in caplog.records)


def test_validate_duplicate_rows_warns(caplog):
    df = pd.DataFrame({"id": [1, 1, 2]})
    with caplog.at_level(logging.WARNING):
        data_quality.validate_duplicate_rows(df, subset=["id"])
    assert any("duplicada" in record.message for record in caplog.records)