+\"\"\"
+SQLAlchemy ORM models and session factory for the warning system.
+
+This module defines declarative models for the ``user_decisions``,
+``warning_rules`` and ``geografia`` tables and provides helpers to
+create an engine, initialize the schema and obtain a session.
+
+It is intentionally self-contained so it can be dropped into the
+current codebase without touching other modules. Migration to this
+layer can be done incrementally by swapping calls in the repository.
+\"\"\"
+from __future__ import annotations
+
+from typing import Optional
+import os
+from datetime import datetime
+
+from sqlalchemy import String, Text, Integer, DateTime, create_engine
+from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column, sessionmaker, Session
+
+
+class Base(DeclarativeBase):
+    \"\"\"Base declarativa para os modelos.\"\"\"
+    pass
+
+
+class UserDecision(Base):
+    __tablename__ = \"user_decisions\"
+
+    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
+    warning_type: Mapped[str] = mapped_column(String, nullable=False)
+    context_hash: Mapped[str] = mapped_column(String, nullable=False, index=True)
+    user_decision: Mapped[str] = mapped_column(String, nullable=False)
+    created_at: Mapped[datetime] = mapped_column(DateTime, nullable=False, default=datetime.utcnow)
+
+
+class WarningRule(Base):
+    __tablename__ = \"warning_rules\"
+
+    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
+    pattern: Mapped[str] = mapped_column(Text, nullable=False, index=True)
+    action: Mapped[str] = mapped_column(String, nullable=False)
+    replacement_value: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
+    created_at: Mapped[datetime] = mapped_column(DateTime, nullable=False, default=datetime.utcnow)
+
+
+class Geografia(Base):
+    __tablename__ = \"geografia\"
+
+    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
+    cidade: Mapped[str] = mapped_column(String, nullable=False, index=True)
+    estado: Mapped[str] = mapped_column(String, nullable=False)
+    regiao: Mapped[str] = mapped_column(String, nullable=False)
+
+
+_SessionFactory: Optional[sessionmaker[Session]] = None
+_ENGINE_URL_ENV = \"WARNINGS_DATABASE_URL\"
+_DEFAULT_SQLITE_URL = \"sqlite:///warnings.db\"
+
+
+def make_engine(url: Optional[str] = None):
+    \"\"\"Cria um engine SQLAlchemy 2.0.
+
+    Parameters
+    ----------
+    url : str | None
+        URL do banco. Se None, usa a variável de ambiente
+        ``WARNINGS_DATABASE_URL`` ou ``sqlite:///warnings.db``.
+    \"\"\"
+    db_url = url or os.getenv(_ENGINE_URL_ENV, _DEFAULT_SQLITE_URL)
+    # future=True não é necessário em 2.0, mas mantém intenção explícita.
+    engine = create_engine(db_url, future=True)
+
+    # Otimizações opcionais para SQLite
+    if db_url.startswith(\"sqlite\"):
+        with engine.begin() as conn:
+            conn.exec_driver_sql(\"PRAGMA journal_mode=WAL;\")
+            conn.exec_driver_sql(\"PRAGMA synchronous=NORMAL;\")
+            conn.exec_driver_sql(\"PRAGMA temp_store=MEMORY;\")
+    return engine
+
+
+def init_db(url: Optional[str] = None) -> None:
+    \"\"\"Cria as tabelas caso não existam.\"\"\"
+    engine = make_engine(url)
+    Base.metadata.create_all(engine)
+
+
+def get_session(url: Optional[str] = None) -> Session:
+    \"\"\"Obtém uma sessão (instancia lazily um SessionFactory singleton).\"\"\"
+    global _SessionFactory
+    if _SessionFactory is None:
+        engine = make_engine(url)
+        _SessionFactory = sessionmaker(bind=engine, future=True)
+    return _SessionFactory()
+
+
+__all__ = [
+    \"Base\",
+    \"UserDecision\",
+    \"WarningRule\",
+    \"Geografia\",
+    \"make_engine\",
+    \"init_db\",
+    \"get_session\",
+]
