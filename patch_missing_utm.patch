+
+
+class DummyFetcher:
+    def __init__(self):
+        self.calls = 0
+        self.cache = {}
+        self.header_cache = {}
+
+    def get(self, names, as_frame=True):
+        self.calls += 1
+        result = {}
+        for n in names:
+            df = self.cache.get(n)
+            if df is None:
+                df = pd.DataFrame({"ID": [1]})
+                self.cache[n] = df
+            result[n] = df
+            self.header_cache[n] = df.columns.tolist()
+        return result
+
+    def get_cached(self, names, as_frame=True):
+        return {n: self.cache[n] for n in names}
