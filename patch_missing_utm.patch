git apply --3way <<'EOF'
diff --git a/extract/__init__.py b/extract/__init__.py
index e69de29..4b2c6a4 100644
--- a/extract/__init__.py
+++ b/extract/__init__.py
@@
+# Simple convenience wrapper around SheetsFetcher
+#
+# Usage:
+#   from extract import read_df
+#   df = read_df(sheet_id="...", tab="modeloGeral", header_row=0)
+#
+import os
+from typing import Any
+
+from .sheets_fetcher import SheetsFetcher
+
+__all__ = ["read_df", "SheetsFetcher"]
+
+
+def _default_creds_path() -> str:
+    """
+    Retorna caminho do arquivo de credenciais de serviço.
+    Honra a variável de ambiente GOOGLE_CREDS_PATH; fallback para creds.json.
+    """
+    return os.getenv("GOOGLE_CREDS_PATH", "creds.json")
+
+
+def read_df(
+    sheet_id: str,
+    tab: str,
+    *,
+    header_row: int = 0,
+    creds_path: str | None = None,
+) -> Any:
+    """
+    Lê uma única aba de um Google Sheets e devolve como DataFrame.
+
+    Parâmetros:
+    - sheet_id : ID da planilha
+    - tab      : nome da aba
+    - header_row : linha (zero-based) do cabeçalho
+    - creds_path : caminho opcional das credenciais; usa env var ou creds.json
+    """
+    fetcher = SheetsFetcher(
+        spreadsheet_id=sheet_id,
+        creds_path=creds_path or _default_creds_path(),
+        header_row=header_row,
+    )
+    return fetcher.get([tab])[tab]
+
EOF
