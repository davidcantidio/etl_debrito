 def _idx_to_col(idx: int) -> str:
     """Converte índice 0-based em letras de coluna estilo A1 (A, B, …, AA…)."""
     out = ""
     while True:
         idx, rem = divmod(idx, 26)
         out = chr(65 + rem) + out
         if idx == 0:
             return out
