+    """Helper para notebooks: processa várias abas já carregadas."""
+    fetcher = getattr(builtins, "fetcher", None) or SheetsFetcher(spreadsheet_id, creds_path)
+    builtins.fetcher = fetcher
+
+    raw_copy = {name: df.copy() for name, df in preloaded_raw.items()}
+    for name, df in raw_copy.items():
+        log.debug("Aba '%s' colunas originais: %s", name, df.columns.tolist())
+
+    prefetch_meta(fetcher, spreadsheet_id)
+
+    dest_payloads: List[dict] = []
+    results: Dict[str, dict] = {}
